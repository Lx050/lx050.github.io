.hud{position:fixed;inset:0;pointer-events:none;opacity:0;transition:opacity .7s}.playing .hud{opacity:1}.hud::before{content:"";position:absolute;inset:0 0 auto;height:150px;background:linear-gradient(#0c0e10c9,transparent);pointer-events:none}.hud button,.hud a,.hud details,.hud canvas,.hud [role="slider"]{pointer-events:auto}.topbar{position:absolute;left:36px;right:36px;top:max(26px,env(safe-area-inset-top));display:flex;align-items:center;justify-content:space-between;gap:22px}.identity{display:flex;align-items:center;gap:14px}.seal{display:grid;place-items:center;width:29px;height:34px;border:1px solid var(--red);color:var(--red);font:18px var(--serif)}.wordmark{font:25px/1 var(--serif);letter-spacing:1px}.subtitle{font-size:10px;color:var(--muted);letter-spacing:3px;margin-top:7px}.districts{display:flex;gap:8px;padding:5px;border:1px solid var(--line);border-radius:30px;background:#0c0e1070}.districts button{padding:6px 16px;border-radius:20px;color:var(--muted);transition:background .2s,color .2s}.districts button.active{background:#e8e2d514;color:var(--paper)}.districts span{font:10px monospace;color:#807e76;margin-left:8px}.tools{display:flex;align-items:center;gap:17px;color:var(--muted);font-size:11px}.tools button{padding:8px 0}.tools button:hover{color:var(--paper)}#visited{font:11px monospace;letter-spacing:1px}.viewpad{position:absolute;right:36px;top:105px;width:94px;height:75px;border:1px solid var(--line);border-radius:10px;background:#0c0e1055;touch-action:none;pointer-events:auto;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--muted);cursor:grab;user-select:none}.viewpad:active{cursor:grabbing}.viewpad .arrows{font:24px var(--serif);line-height:1.2;color:var(--paper)}.viewpad small{font-size:10px;letter-spacing:2px;margin-top:6px}.viewpad:focus-visible{outline:2px solid var(--red)}
.margin-note{position:absolute;left:39px;top:126px;writing-mode:vertical-rl;letter-spacing:5px;font:13px/2 var(--serif);color:#aaa69b99}.margin-note i{height:40px;width:1px;background:var(--red);display:inline-block;margin-bottom:20px;opacity:.6}.bottom-note{position:absolute;bottom:30px;left:36px;color:var(--muted);font-size:10px;letter-spacing:1px}.bottom-note p{margin:5px 0}.bottom-note kbd{display:inline-block;border:1px solid var(--line);border-radius:3px;padding:0 4px;font:10px/1.6 monospace;color:var(--paper)}#location{color:var(--paper);font-size:12px;letter-spacing:3px;margin-bottom:10px}#location::before{content:"";display:inline-block;width:5px;height:5px;background:var(--red);border-radius:50%;margin-right:9px}.mapbox{position:absolute;right:30px;bottom:24px;text-align:center}.mapbox canvas{width:144px;height:144px;opacity:.9}.mapbox small{display:block;color:var(--muted);font-size:9px;letter-spacing:3px;margin-top:-4px}
#interaction{position:absolute;left:50%;bottom:max(32px,env(safe-area-inset-bottom));width:min(480px,calc(100% - 48px));transform:translate(-50%,12px);opacity:0;visibility:hidden;pointer-events:none;transition:opacity .25s,transform .25s,visibility .25s;border:1px solid var(--line);border-top-color:#c0563e88;border-radius:8px;background:rgba(15,18,19,.94);padding:18px 21px;display:flex;align-items:center;gap:20px;box-shadow:0 12px 50px #0004}#interaction.visible{opacity:1;visibility:visible;transform:translate(-50%,0);pointer-events:auto}.entry-copy{flex:1;min-width:0}.eyebrow{font-size:9px;letter-spacing:3px;color:var(--red)}#entry-title{margin:3px 0 4px;font:21px/1.4 var(--serif)}#entry-desc{margin:0;font-size:11px;color:var(--muted)}#enter-link{flex-shrink:0;display:block;text-decoration:none;border-left:1px solid var(--line);padding:10px 0 10px 20px;font-size:12px}#enter-link span{display:block;color:var(--muted);font-size:9px;margin-top:3px}#ambient-hint{position:absolute;left:50%;bottom:41px;transform:translateX(-50%);color:var(--muted);font:13px var(--serif);letter-spacing:3px;white-space:nowrap;transition:opacity .3s}.nearby #ambient-hint{opacity:0}
#joystick{display:none;position:absolute;left:24px;bottom:150px;width:112px;height:112px;border:1px solid #e8e2d52b;border-radius:50%;background:#e8e2d505;touch-action:none;user-select:none;pointer-events:auto}#joystick::before,#joystick::after{content:"";position:absolute;background:#e8e2d510;left:50%;top:14%;width:1px;height:72%}#joystick::after{transform:rotate(90deg)}#stick{position:absolute;left:35px;top:35px;width:40px;height:40px;background:#e8e2d522;border:1px solid #e8e2d550;border-radius:50%;z-index:1}#joystick small{position:absolute;top:120px;width:100%;text-align:center;color:var(--muted);font-size:9px;letter-spacing:3px}.touch #joystick{display:block}.touch .desktop-help{display:none}
#intro{position:fixed;inset:0;z-index:10;display:flex;align-items:center;justify-content:center;background:linear-gradient(90deg,#0c0e10e8 0%,#0c0e108a 43%,#0c0e101a 100%);transition:opacity .8s,visibility .8s}#intro.gone{opacity:0;visibility:hidden;pointer-events:none}.intro-inner{width:100%;max-width:1280px;padding:0 8vw}.intro-kicker{color:var(--muted);font-size:10px;letter-spacing:5px;display:flex;align-items:center;gap:15px}.intro-kicker::before{content:"";width:30px;height:1px;background:var(--red)}h1{margin:24px 0 12px;font:clamp(68px,9vw,128px)/1.1 var(--serif);font-weight:400;letter-spacing:-3px}.intro-poem{font:clamp(18px,2.2vw,25px)/1.8 var(--serif);letter-spacing:5px}.intro-line{width:36px;height:1px;background:var(--line);margin:31px 0 25px}.intro-description{color:var(--muted);font-size:12px;line-height:2.2;letter-spacing:1px}.start{display:inline-flex;align-items:center;gap:35px;margin:23px 0 0;padding:13px 0;border-bottom:1px solid #c0563e88;font-size:13px;letter-spacing:3px}.start .arrow{font-size:22px;color:var(--red);letter-spacing:0}.intro-controls{font-size:10px;letter-spacing:1px;color:#99968c;margin-top:25px}.intro-footer{position:absolute;bottom:30px;left:8vw;right:8vw;display:flex;justify-content:space-between;font-size:9px;letter-spacing:3px;color:#aaa69b88}
#directory{position:fixed;inset:0;z-index:20;background:#080a0bd9;padding:6vh 20px;overflow:auto}#directory[hidden]{display:none}.directory-inner{max-width:800px;margin:auto;background:#141718;border:1px solid var(--line);padding:30px;border-radius:12px}.directory-head{display:flex;justify-content:space-between;align-items:center;gap:20px}.directory-head h2{font:26px var(--serif);margin:0}.directory-head button{font-size:22px;width:42px;height:42px}.directory-sub{color:var(--muted);font-size:12px}.directory-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px 32px}.directory-grid h3{font-size:11px;color:var(--red);letter-spacing:4px;font-weight:400}.directory-grid a{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid #e8e2d50e;text-decoration:none}.directory-grid a:hover{color:#fff}.directory-grid a span{color:var(--muted);font-size:10px;text-align:right;flex-shrink:0}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}#error{position:fixed;inset:0;z-index:15;display:grid;place-content:center;padding:30px;background:#0c0e10;text-align:center}#error[hidden]{display:none}#error p{max-width:380px;color:var(--muted)}#error button{padding:12px 24px;border:1px solid var(--line);margin:15px auto}noscript{position:fixed;inset:0;z-index:30;display:grid;place-content:center;background:var(--ink);padding:25px}
@media(max-width:760px){.topbar{left:20px;right:20px;top:max(20px,env(safe-area-inset-top));flex-wrap:wrap;gap:19px}.wordmark{font-size:22px}.subtitle{font-size:8px}.seal{width:25px;height:30px;font-size:15px}.tools{gap:13px}.districts{order:3;gap:0;padding:3px}.districts button{padding:6px 12px;font-size:11px}.districts span{margin-left:5px;font-size:9px}.viewpad{right:20px;top:139px;width:76px;height:66px}.margin-note{display:none}.bottom-note{left:20px;bottom:25px}.bottom-note .desktop-help{display:none}.mapbox{right:15px;bottom:151px}.mapbox canvas{width:112px;height:112px}.mapbox small{font-size:8px}.touch .bottom-note{bottom:290px;left:26px}#interaction{bottom:max(25px,env(safe-area-inset-bottom));padding:15px 17px;width:calc(100% - 36px);gap:12px}#entry-title{font-size:19px}#entry-desc{font-size:10px}#enter-link{padding-left:14px}#ambient-hint{bottom:68px;font-size:11px;letter-spacing:2px}.intro-inner{padding:0 9vw}.intro-poem{letter-spacing:3px;font-size:17px}.intro-controls{max-width:245px;line-height:2}.intro-footer{font-size:8px;letter-spacing:1px}.intro-description{font-size:11px}.directory-inner{padding:20px}.directory-grid{grid-template-columns:1fr;gap:10px}.intro-kicker{font-size:9px;letter-spacing:3px}}
@media(max-height:540px){.intro-inner{padding-left:8vw}.intro-kicker,.intro-line,.intro-description,.intro-footer{display:none}h1{font-size:56px;margin-top:0}.intro-poem{font-size:16px}.start{margin-top:5px}.intro-controls{margin-top:12px}.mapbox{bottom:10px}.touch #joystick{bottom:30px;width:100px;height:100px}.touch #stick{left:29px;top:29px}.touch .bottom-note{display:none}.viewpad{top:98px}.topbar{top:15px}.districts{order:initial}.margin-note{display:none}#interaction{max-width:390px;bottom:18px}.mapbox canvas{width:96px;height:96px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;animation:none!important}}
#bgm-button{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;width:28px;height:28px;padding:5px;border:1px solid var(--line);border-radius:5px;background:var(--ink);color:var(--paper)}
#bgm-button[hidden]{display:none}#bgm-button:hover{border-color:var(--muted)}#bgm-button:focus-visible{outline:2px solid var(--paper);outline-offset:3px}
#bgm-button svg{width:16px;height:16px}#bgm-button .bgm-waves{display:none}#bgm-button[aria-pressed="true"] .bgm-waves{display:inline}#bgm-button[aria-pressed="true"] .bgm-cross{display:none}
@media(max-width:380px){#bgm-button{width:24px;height:24px;padding:3px}}
/* 横屏低高度（手机横屏 / 矮窗口）：顶栏压成一行，避免与分区导航、视角盘重叠 */
@media(orientation:landscape) and (max-height:540px){
  .topbar{top:max(8px,env(safe-area-inset-top));left:16px;right:16px;gap:10px;flex-wrap:nowrap;align-items:center}
  .identity{gap:9px}.identity .subtitle{display:none}.wordmark{font-size:19px}.seal{width:23px;height:27px;font-size:14px}
  .districts{padding:3px;gap:0;order:0}.districts button{padding:5px 10px;font-size:11px}.districts span{font-size:9px;margin-left:4px}
  .tools{gap:10px;font-size:10px}.tools button{padding:6px 0}
  #bgm-button{position:static;width:26px;height:26px;padding:4px}
}
.music-credits{grid-column:1/-1;margin-top:14px;padding-top:18px;border-top:1px solid #e8e2d50e}
.music-credits h3{font-size:11px;color:var(--red);letter-spacing:4px;font-weight:400;margin:0 0 8px}
.music-credits small{display:block;color:var(--muted);font-size:11px;line-height:1.9;font-size:11px}
.music-credits .mc-note{margin-bottom:8px;opacity:.8}
/* 极窄竖屏（≤380）：收紧工具组间距，保证归庭/目录文字不被压成竖排 */
@media(max-width:380px){.tools{gap:9px}}
/* Batch 8: 手机端极简 — music/time/counters off, nav collapses to one quiet top row. Desktop untouched. */
@media(max-width:760px){
  #bgm-button,#sky-button,#bridge-count,#visited,.wordmark,.subtitle,.districts span{display:none}
  .topbar{flex-wrap:nowrap;gap:10px}
  .identity{gap:0;flex-shrink:0}
  .districts{order:initial;padding:3px;background:#0c0e1050;border-radius:24px;flex-shrink:0}
  .districts button{padding:5px 9px;font-size:10px}
  .tools{gap:12px;font-size:10px;flex-shrink:0}
  .tools button{padding:6px 0;color:#807e76}
  .hud::before{height:88px;background:linear-gradient(#0c0e10a6,transparent)}
}
</style>
<style id="bridge-style">#bridge-count{font:11px monospace;letter-spacing:1px;color:var(--paper)}#bridge-count.done{color:var(--red)}#bridge-toast{position:absolute;left:50%;bottom:120px;transform:translateX(-50%);color:var(--paper);font:13px/1.8 var(--serif);letter-spacing:2px;background:#0c0e10d9;border:1px solid var(--line);border-radius:6px;padding:8px 18px;opacity:0;transition:opacity .3s;pointer-events:none;white-space:nowrap}#bridge-toast.show{opacity:1}#euler-card{position:absolute;right:30px;bottom:210px;width:min(360px,calc(100% - 60px));border:1px solid #c0563e88;border-radius:8px;background:rgba(15,18,19,.94);padding:18px 20px;display:flex;align-items:center;gap:16px;box-shadow:0 12px 50px #0004}#euler-card[hidden]{display:none}#euler-card h2{font:18px/1.4 var(--serif);margin:3px 0 4px}#euler-card p{margin:0;font-size:11px;color:var(--muted)}#euler-action{flex-shrink:0;border-left:1px solid var(--line);padding:10px 0 10px 16px;color:var(--paper);letter-spacing:2px;font-size:12px}#euler-action[hidden]{display:none}</style>
</head>
<body>
<main id="world" tabindex="-1" aria-label="可探索的三维数字庭院。使用 WASD 或方向键行走；靠近建筑后按回车访问。"></main>
<div class="vignette" aria-hidden="true"></div>
<div class="hud" id="hud" inert>
  <header class="topbar">
    <div class="identity"><span class="seal" aria-hidden="true">游</span><div><div class="wordmark">Lx050</div><div class="subtitle">数字庭院 · 夜游</div></div></div>
    <nav class="districts" aria-label="前往分区">
      <button data-zone="0" title="前往作品区">作品<span>08</span></button><button data-zone="1" title="前往服务区">服务<span>05</span></button><button data-zone="2" title="前往项目区">项目<span>11</span></button><button data-zone="3" title="前往连接区">连接<span>02</span></button>
    </nav>
    <div class="tools"><button id="sky-button" type="button" title="天时流转 · 点击拨到下一时相">天时 · 夜</button><span id="bridge-count" title="七桥挑战:每桥恰走一次" aria-live="polite">七桥 0/7</span><span id="visited" title="已探访并点亮的入口" aria-live="polite">00 / 26</span><button id="home" title="返回庭心（R）">归庭</button><button id="list-button" aria-haspopup="dialog">目录 ↗</button><button id="bgm-button" type="button" aria-label="开启背景音乐" aria-pressed="false" title="开启背景音乐"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 4 6 8H3v8h3l5 4Z"/><g class="bgm-waves"><path d="M15 8a6 6 0 0 1 0 8M18 5a10 10 0 0 1 0 14"/></g><path class="bgm-cross" d="m16 9 6 6m0-6-6 6"/></svg></button></div>
  </header>
  <div class="margin-note" aria-hidden="true"><i></i>灯火所及，皆是来处。</div>
  <div class="viewpad" id="viewpad" tabindex="0" role="group" aria-label="视角控制：拖动旋转视角，聚焦后使用方向键调整，Home 重置"><span class="arrows">↔</span><small>拖动视角</small></div>
  <div class="bottom-note"><div id="location">庭心</div><div class="desktop-help"><p><kbd>W</kbd> <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd> / 方向键 · 行走</p><p><kbd>↵</kbd> / <kbd>空格</kbd> · 访问　拖动画面 · 环顾</p></div></div>
  <div id="joystick" aria-label="移动摇杆"><div id="stick"></div><small>拖动行走</small></div>
  <div class="mapbox"><canvas id="map" width="288" height="288" aria-label="庭院地图：朱砂色圆点为当前位置"></canvas><small>一岛 · 二十六盏灯</small></div>
  <div id="ambient-hint">提灯走近，让故事发生。</div>
  <section id="interaction" aria-label="附近的入口">
    <div class="entry-copy" aria-live="polite"><div class="eyebrow" id="entry-zone"></div><h2 id="entry-title"></h2><p id="entry-desc"></p></div>
    <a id="enter-link" target="_blank" rel="noopener noreferrer">访问 ↗<span>ENTER / 空格</span></a>
  </section>
  <div id="bridge-toast" aria-live="polite"></div>
  <section id="euler-card" aria-label="七桥挑战" hidden><div class="entry-copy"><div class="eyebrow">1736 · 柯尼斯堡</div><h2 id="euler-title">七桥 · 欧拉的判定</h2><p id="euler-text"></p></div><button id="euler-action">架设新桥 ↗</button></section>
</div>
<section id="intro" aria-label="进入数字庭院">
  <div class="intro-inner"><div class="intro-kicker">A SMALL ISLAND OF THOUGHTS</div><h1>Lx050<span style="color:var(--red)">.</span></h1><div class="intro-poem">在数字之间，留一点人间</div><div class="intro-line"></div><p class="intro-description">一些作品，一些故事，一些仍在生长的念头。<br>借一盏灯，随意走走。</p><button class="start" id="start" disabled>正在点灯<span class="arrow">↗</span></button><div class="intro-controls" id="intro-controls">WASD / 方向键行走 · 拖动环顾 · 回车访问<br>点击或按任意键，开始夜游</div></div>
  <div class="intro-footer"><span>作品 / 服务 / 项目 / 连接</span><span>慢一点，也没有关系。 &nbsp; © Lx050</span></div>
</section>
<section id="directory" role="dialog" aria-modal="true" aria-labelledby="directory-title" hidden><div class="directory-inner"><div class="directory-head"><h2 id="directory-title">庭院目录</h2><button id="close-directory" aria-label="关闭目录">×</button></div><p class="directory-sub">二十六个入口，也可以直接抵达。所有链接在新标签页打开。</p><div id="directory-grid" class="directory-grid"></div><div class="music-credits" id="music-credits"></div></div></section>
<div id="error" role="alert" hidden><h2 style="font-family:var(--serif);font-weight:400">灯还没有亮起来</h2><p id="error-message">三维场景暂时无法加载，请刷新重试。也可以从目录直接访问全部入口。</p><button id="fallback-list">打开庭院目录 ↗</button></div>
<noscript>请启用 JavaScript，来这座小岛走走。</noscript>
<script src="vendor/three.min.js"></script>
<script src="vendor/three/GLTFLoader.js"></script>
<script src="vendor/three/CopyShader.js"></script>
<script src="vendor/three/LuminosityHighPassShader.js"></script>
<script src="vendor/three/EffectComposer.js"></script>
<script src="vendor/three/RenderPass.js"></script>
<script src="vendor/three/ShaderPass.js"></script>
<script src="vendor/three/UnrealBloomPass.js"></script>
<script>
(() => {
'use strict';
// Every destination owns one physical landmark, a Sprite label, and a directory link.
const LINKS = [
  {zone:0,title:'墨息',desc:'数字毛笔书写，让落笔重新有温度。',url:'https://moxi.maniforld.com',x:-20,z:-19},
  {zone:0,title:'画韵新生',desc:'以 AI 修复古画，续写纸上的岁月。',url:'https://huayun.maniforld.com',x:-14,z:-19},
  {zone:0,title:'画韵新生·旧址',desc:'旧时的入口，留住最初的一笔。',url:'https://hyxs.art',x:-8,z:-19},
  {zone:0,title:'墨生',desc:'AI 古画修复，让旧墨再生。',url:'https://mosheng.maniforld.com',x:-20,z:-13},
  {zone:0,title:'暖聆',desc:'家人守护台，让牵挂有处安放。',url:'https://nuanling.maniforld.com',x:-14,z:-13},
  {zone:0,title:'暖聆App',desc:'把家人的守护，轻轻放进口袋。',url:'https://nuanling.maniforld.com/app/',x:-8,z:-13},
  {zone:0,title:'排版助手',desc:'整理文字的秩序，让表达更清晰。',url:'https://editor.maniforld.com',x:-20,z:-7},
  {zone:0,title:'金陵专利局',desc:'金陵专利局的线上入口。',url:'https://patent.maniforld.com',x:-12,z:-7},
  {zone:1,title:'RSS',desc:'用订阅，留住值得慢慢读的声音。',url:'https://rss.maniforld.com',x:-19,z:6},
