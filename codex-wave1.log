  for(let i=0;i<9;i++){
    const lx=-half+(i+.5)*(L/9),y=bridgeDeckY(lx,L,rise);
    const slope=(bridgeDeckY(lx+.05,L,rise)-bridgeDeckY(lx-.05,L,rise))/.1;
    const slab=mesh(G.box,i%3===1?M.stone:M.path,g,lx,y-.06,0,L/9*1.05,.12,2.14);
    slab.rotation.z=Math.atan(slope);slab.castShadow=i===4;
