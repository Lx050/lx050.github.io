    button.setAttribute('aria-label',button.title);
  }
  function disable(){
    unavailable=true;request++;showPlaying(false);button.disabled=true;button.hidden=true;
    try{if(audio)audio.pause();}catch(error){/* Audio must never interrupt the garden. */}
    try{if(context)context.close().catch(()=>{});}catch(error){/* Already closed. */}
  }
  function fadeTo(target,seconds){
    if(!gain)return;
    const now=context.currentTime;
    const progress=envelope.end>envelope.start?Math.max(0,Math.min(1,(now-envelope.start)/(envelope.end-envelope.start))):1;
    const cv=envelope.from+(envelope.to-envelope.from)*progress;
    gain.gain.cancelScheduledValues(now);
    gain.gain.setValueAtTime(cv,now);
    gain.gain.linearRampToValueAtTime(target,now+seconds);
    envelope={from:cv,to:target,start:now,end:now+seconds};
  }
