function bridgeDeckY(x,L,rise){const half=L/2,c=Math.cos(Math.max(-1,Math.min(1,x/half))*Math.PI/2);return .055+rise*c;}
function buildBridge(b){
  const g=new THREE.Group();scene.add(g);
