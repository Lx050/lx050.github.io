  for(const e of [-1,1])for(let k=0;k<2;k++)mesh(G.box,M.stone,g,e*(half+.3+k*.4),.065-k*.02,0,.52,.11-k*.025,2-k*.14).castShadow=false;
  // 望柱 + 栏板 per side; the midspan panel is left open (让月).
  const postXs=[-half*.96,-half*.32,half*.32,half*.96];
