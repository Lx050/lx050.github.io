// Audio owns its own clock: neither render quality nor tab visibility changes it.
const bgm=(()=>{
  const button=$('bgm-button'),storageKey='garden-bgm',volume=.22,prefix='assets/audio/tracks/';
  let audio,context,gain,unavailable=false,wanted=true,request=0,failures=0;
  let order=[],pos=0,current=-1;
  let envelope={from:0,to:0,start:0,end:0};
  try{wanted=localStorage.getItem(storageKey)!=='off';}catch(error){/* Session preference still works. */}
  function showPlaying(playing){
    button.setAttribute('aria-pressed',String(playing));
    button.title=playing?'关闭背景音乐':'开启背景音乐';
    button.setAttribute('aria-label',button.title);
  }
  function disable(){
    unavailable=true;request++;showPlaying(false);button.disabled=true;button.hidden=true;
    try{if(audio)audio.pause();}catch(error){/* Audio must never interrupt the garden. */}
    try{if(context)context.close().catch(()=>{});}catch(error){/* Already closed. */}
  }
  function fadeTo(target,seconds){
    if(!gain)return;
    const now=context.currentTime;
    const progress=envelope.end>envelope.start?Math.max(0,Math.min(1,(now-envelope.start)/(envelope.end-envelope.start))):1;
    const cv=envelope.from+(envelope.to-envelope.from)*progress;
    gain.gain.cancelScheduledValues(now);
    gain.gain.setValueAtTime(cv,now);
    gain.gain.linearRampToValueAtTime(target,now+seconds);
    envelope={from:cv,to:target,start:now,end:now+seconds};
  }
  function reshuffle(){order=TRACKS.map((_,i)=>i);for(let i=order.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[order[i],order[j]]=[order[j],order[i]];}pos=0;}
  function pickNext(){if(!order.length||pos>=order.length)reshuffle();return order[pos++];}
  function loadTrack(i,fadeIn){
    const ticket=request;current=i;failures=0;
    try{audio.src=prefix+TRACKS[i].f;}catch(error){disable();return;}
    const playing=audio.play();
    if(playing&&playing.then)playing.then(()=>{if(ticket===request&&!unavailable)fadeTo(wanted?volume:0,fadeIn);}).catch(error=>{
      if(error&&error.name==='NotAllowedError'){wanted=false;fadeTo(0,.4);showPlaying(false);}
    });
  }
  function nextTrack(fadeIn=1.1){if(unavailable)return;if(failures>TRACKS.length){disable();return;}loadTrack(pickNext(),fadeIn);}
  function playbackFailure(){failures++;if(failures>TRACKS.length){disable();return;}loadTrack(pickNext(),.5);}
  function play(seconds){
    if(unavailable)return;
    const ticket=++request;
    try{
      if(!context){
        const AudioContext=window.AudioContext||window.webkitAudioContext;
        context=new AudioContext();gain=context.createGain();gain.gain.value=0;
        source=context.createMediaElementSource(audio);source.connect(gain);gain.connect(context.destination);
      }
      // Both calls stay synchronous in the entry/click gesture, including on iOS.
      const resumed=context.resume();
      let playing;
      try{playing=audio.play();}catch(error){Promise.resolve(resumed).catch(()=>{});throw error;}
      Promise.all([resumed,playing]).then(()=>{
        if(unavailable||ticket!==request)return;
        fadeTo(wanted?volume:0,seconds);showPlaying(wanted);
      }).catch(error=>{
        if(error?.name==='NotAllowedError'){wanted=false;fadeTo(0,.4);showPlaying(false);}else disable();
      });
    }catch(error){if(error?.name==='NotAllowedError'){wanted=false;showPlaying(false);}else disable();}
  }
  let source;
  try{
    audio=new Audio();audio.preload='none';
    audio.addEventListener('error',()=>{if(audio.src&&started&&audio.error)playbackFailure();});
    audio.addEventListener('ended',()=>{if(!wanted)return;fadeTo(0,.5);setTimeout(()=>{if(wanted&&!unavailable)nextTrack(1.4);},380);});
    reshuffle();current=pickNext();audio.src=prefix+TRACKS[current].f;
  }catch(error){disable();}
  button.addEventListener('click',()=>{
    if(unavailable||!started)return;
    wanted=!wanted;
    try{localStorage.setItem(storageKey,wanted?'on':'off');}catch(error){/* Keep the choice for this visit. */}
    if(wanted){request++;play(.5);}
    else{request++;try{fadeTo(0,.4);showPlaying(false);}catch(error){disable();}}
  });
  return {start:()=>play(2.5)};
})();
