const terraceSites=LINKS.map((entry,index)=>{
  const r=Math.hypot(entry.x,entry.z),ux=entry.x/r,uz=entry.z/r;
  const steps=20+(index%5)*4, rise=steps*WORLD.STEP_HEIGHT;
