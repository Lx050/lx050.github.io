      try{playing=audio.play();}catch(error){Promise.resolve(resumed).catch(()=>{});throw error;}
      Promise.all([resumed,playing]).then(()=>{
        if(unavailable||ticket!==request)return;
        fadeTo(wanted?volume:0,seconds);showPlaying(wanted);
      }).catch(error=>{
        if(error?.name==='NotAllowedError'){wanted=false;fadeTo(0,.4);showPlaying(false);}else disable();
      });
    }catch(error){if(error?.name==='NotAllowedError'){wanted=false;showPlaying(false);}else disable();}
  }
  let source;
  try{
    audio=new Audio();audio.preload='none';
    audio.addEventListener('error',()=>{if(audio.src&&started&&audio.error)playbackFailure();});
    audio.addEventListener('ended',()=>{if(!wanted)return;fadeTo(0,.5);setTimeout(()=>{if(wanted&&!unavailable)nextTrack(1.4);},380);});
    reshuffle();current=pickNext();audio.src=prefix+TRACKS[current].f;
  }catch(error){disable();}
