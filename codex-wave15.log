const gltfLoader=new THREE.GLTFLoader();
function glbRefine(root,glowOverride){
  root.traverse(o=>{if(o.isMesh){
    const base=(o.material&&o.material.name||'').replace(/\.\d+$/,'');
    o.material=(base==='glow'&&glowOverride)?glowOverride:(M[base]||M.stone);
    o.castShadow=true;o.receiveShadow=true;
  }});
  return root;
}
const modelLoads={loaded:[],failed:[]};
function glbLoad(url){return new Promise((resolve,reject)=>gltfLoader.load(url,g=>{modelLoads.loaded.push(url);resolve(g.scene);},undefined,e=>{modelLoads.failed.push(url);reject(e);}));}
function instancePrototype(proto,placements,heightOf){
  const root=glbRefine(proto.clone(true));root.updateWorldMatrix(true,true);
  const box=new THREE.Box3().setFromObject(root),size=box.getSize(new THREE.Vector3()),center=box.getCenter(new THREE.Vector3());
  const byGeometry=new Map();
  root.traverse(o=>{if(!o.isMesh)return;const key=o.geometry.uuid+o.material.uuid;if(!byGeometry.has(key))byGeometry.set(key,{geo:o.geometry,mat:o.material,parts:[]});byGeometry.get(key).parts.push(o.matrixWorld.clone());});
  for(const b of byGeometry.values()){
    const im=new THREE.InstancedMesh(b.geo,b.mat,placements.length*b.parts.length);let n=0;
    for(const p of placements){const k=heightOf(p)/size.y,base=new THREE.Matrix4().makeTranslation(p.x,p.y,p.z);
      base.multiply(new THREE.Matrix4().makeRotationY(p.rot||0)).multiply(new THREE.Matrix4().makeScale(k,k,k)).multiply(new THREE.Matrix4().makeTranslation(-center.x,-box.min.y,-center.z));
      for(const part of b.parts)im.setMatrixAt(n++,new THREE.Matrix4().multiplyMatrices(base,part));
    }
    im.castShadow=true;im.receiveShadow=true;scene.add(im);
  }
}
function glbPlace(proto,parent,x,y,z,s,rotY,glowOverride){
  const wrap=new THREE.Group();wrap.position.set(x,y,z);wrap.scale.setScalar(s);if(rotY)wrap.rotation.y=rotY;
  wrap.add(glbRefine(proto.clone(true),glowOverride));(parent||scene).add(wrap);return wrap;
}
