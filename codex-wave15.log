    if(!bridgesWalked.has(bid)){
      bridgesWalked.add(bid);if(!bb.bonus){updateBridgeCount();bridgeToast('渡 '+bb.name+' · 七桥 '+bridgesWalked.size+'/7');if(bridgesWalked.size>=7)showEuler();}
