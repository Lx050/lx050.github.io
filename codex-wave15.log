  for(const t of terraceSites){
    const dx=x-t.x,dz=z-t.z,d=Math.hypot(dx,dz),along=dx*t.ux+dz*t.uz,side=-dx*t.uz+dz*t.ux;
    const flatten=1-smooth01((d-t.radius-2)/8);
